# Parse bash case patterns from the script source
with open(script_path) as f:
    source = f.read()

bash_cmds = set()
in_case = False
case_depth = 0
for line in source.split("\n"):
    stripped = line.strip()
    # Detect the top-level command dispatch case
    if not in_case and stripped == 'case "$cmd" in':
        in_case = True
        case_depth = 1
        continue
    if in_case:
        # Track nested case...esac blocks (handle inline case...esac on same line)
        case_count = len(re.findall(r'\bcase\b', stripped))
        esac_count = len(re.findall(r'\besac\b', stripped))
        # Inline case...esac on same line cancels out
        net_depth = case_count - esac_count
        if net_depth != 0:
            case_depth += net_depth
            if case_depth == 0:
                break
            if net_depth > 0:
                continue  # entering nested case, skip pattern matching
        elif case_count > 0:
            continue  # inline case...esac, skip
        # Only match patterns at depth 1 (top-level dispatch)
        if case_depth == 1:
            m = re.match(r'^([\w:.\-|]+)\)$', stripped)
            if m:
                for pat in m.group(1).split("|"):
                    bash_cmds.add(pat.strip())

missing_bash = expected - bash_cmds - implicit
missing_registry = bash_cmds - expected - implicit

errors = 0
warnings = 0

if missing_bash:
    print("❌ In registry but no bash case handler:")
    for cmd in sorted(missing_bash):
        print(f"   add to bash case: {cmd})")
    errors += len(missing_bash)

if missing_registry:
    print("⚠️  Bash case handler but not in registry (consider adding to commands[]):")
    for cmd in sorted(missing_registry):
        print(f"   {cmd}")
    warnings += len(missing_registry)

# Alias collision check
alias_map = {}
for entry in registry:
    for a in entry.get("aliases", []):
        if a in alias_map:
            print(f"❌ Alias collision: '{a}' used by both '{alias_map[a]}' and '{entry['name']}'")
            errors += 1
        else:
            alias_map[a] = entry["name"]

# ── Cross-check with Dart LLM tool catalog ──────────────────────────
# Parse command: 'xxx' entries from the Dart _tools list so that any
# CLI command that should be callable by the LLM is verified to exist
# in both registries.
script_dir = os.path.dirname(os.path.abspath(script_path))
dart_path = os.path.join(script_dir, "lib", "features", "board", "chat", "yoloit_cli_tools.dart")
if not os.path.isfile(dart_path):
    # tools/ is one level deep — try parent
    dart_path = os.path.join(script_dir, "..", "lib", "features", "board", "chat", "yoloit_cli_tools.dart")

dart_total = "?"
if os.path.isfile(dart_path):
    # Read the main file and all .dart files in its cli_tools/ directory
    # so that refactored sub-lists are included in the cross-check.
    dart_src = ""
    with open(dart_path) as f:
        dart_src += f.read() + "\n"
    dart_dir = os.path.dirname(dart_path)
    cli_tools_dir = os.path.join(dart_dir, "cli_tools")
    if os.path.isdir(cli_tools_dir):
        for fname in sorted(os.listdir(cli_tools_dir)):
            if fname.endswith(".dart"):
                with open(os.path.join(cli_tools_dir, fname)) as f:
                    dart_src += f.read() + "\n"

    dart_commands = set(re.findall(r"command:\s*'([^']+)'", dart_src))
    dart_total = len(dart_commands)

    # Commands that are internal / not meant for LLM exposure
    dart_exempt = set()

    bash_names = {e["name"] for e in registry}
    in_bash_not_dart = bash_names - dart_commands - dart_exempt
    in_dart_not_bash = dart_commands - bash_names

    if in_bash_not_dart:
        print("❌ CLI commands missing from Dart LLM tools (_tools list):")
        for cmd in sorted(in_bash_not_dart):
            print(f"   add YoloitCliTool(command: '{cmd}', ...) to yoloit_cli_tools.dart")
        errors += len(in_bash_not_dart)

    if in_dart_not_bash:
        print("❌ Dart LLM tools missing from CLI bash registry:")
        for cmd in sorted(in_dart_not_bash):
            print(f"   add '{cmd}' to commands[] in tools/yoloit")
        errors += len(in_dart_not_bash)
else:
    print("⚠️  Could not find yoloit_cli_tools.dart — skipping Dart cross-check")
    warnings += 1

if errors == 0 and warnings == 0:
    total = len(expected)
    print(f"✅ CLI registry is consistent ({total} commands/aliases, {dart_total} LLM tools, 0 errors)")
elif errors == 0:
    print(f"✅ No errors ({warnings} warnings — bash handlers not in registry are OK)")
else:
    sys.exit(1)
PYEOF
    ;;

    *)
    echo "Unknown command: $cmd" >&2
