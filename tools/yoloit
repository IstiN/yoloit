            continue
        from_node = panel_nodes.get(from_id)
        to_node = panel_nodes.get(to_id)
        if not from_node or not to_node:
            continue
        style = str(link.get('style') or 'arrow').strip().lower()
        geometry = str(link.get('geometry') or '').strip()
        edge = '---' if style == 'line' else '-->'
        if geometry:
            lines.append(f'    {from_node} {edge}|{label(geometry)}| {to_node}')
        else:
            lines.append(f'    {from_node} {edge} {to_node}')
    lines.append('  end')
    if is_active:
        lines.append(f'  style {sg_node} fill:#ecfeff,stroke:#0891b2,stroke-width:2px;')
    else:
        lines.append(f'  style {sg_node} fill:#f8fafc,stroke:#64748b,stroke-width:1px;')

diagram = '\n'.join(lines)
if fmt == 'md':
    print('# Boards Snapshot')
    print()
    print('```mermaid')
    print(diagram)
    print('```')
