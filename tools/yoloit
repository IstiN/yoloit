#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────
# yoloit — CLI client for the YoLoIT desktop app
#
# Communicates with the in-app HTTP server on localhost via curl.
# The server writes its port to ~/.config/yoloit/cli.port on startup.
# ──────────────────────────────────────────────────────────────────────
set -euo pipefail

PORT_FILE="${HOME}/.config/yoloit/cli.port"
STATE_FILE="${HOME}/.config/yoloit/state.json"
BASE=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_runtime_home() {
  if [[ "${YOLOIT_DEV_RUNTIME:-0}" == "1" ]]; then
    echo "${HOME}/.config/yoloit/runtime"
  else
    echo "${YOLOIT_RUNTIME_HOME:-${HOME}/.config/yoloit/runtime}"
  fi
}

_board() {
  local val="${1:-}"
  if [[ -n "$val" ]]; then echo "$val"; return; fi
  if [[ ! -f "$STATE_FILE" ]]; then return; fi
  python3 -c "import json,sys; f=sys.argv[1]; print(json.load(open(f)).get('board',''))" "$STATE_FILE" 2>/dev/null || true
}

_use_board() {
  mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || true
  python3 -c "
import json, sys, os
f = sys.argv[1]
d = json.load(open(f)) if os.path.exists(f) else {}
d['board'] = sys.argv[2]
open(f, 'w').write(json.dumps(d))
" "$STATE_FILE" "$1" 2>/dev/null || true
}

_state_get() {
  local key="$1"
  [[ -f "$STATE_FILE" ]] || return 0
  python3 -c "import json,sys; print((json.load(open(sys.argv[1])).get(sys.argv[2]) or ''))" "$STATE_FILE" "$key" 2>/dev/null || true
}

_state_set() {
  local key="$1" value="$2"
  mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || true
  python3 -c "
import json, sys, os
f, key, value = sys.argv[1:4]
d = json.load(open(f)) if os.path.exists(f) else {}
d[key] = value
open(f, 'w').write(json.dumps(d))
" "$STATE_FILE" "$key" "$value" 2>/dev/null || true
}

_state_del() {
  local key="$1"
  [[ -f "$STATE_FILE" ]] || return 0
  python3 -c "
import json, sys, os
f, key = sys.argv[1:3]
d = json.load(open(f)) if os.path.exists(f) else {}
d.pop(key, None)
open(f, 'w').write(json.dumps(d))
" "$STATE_FILE" "$key" 2>/dev/null || true
}

_remote_url() {
  if [[ -n "${YOLOIT_REMOTE_URL:-}" ]]; then
    printf "%s" "${YOLOIT_REMOTE_URL%/}"
    return
  fi
  _state_get remoteUrl | sed 's:/*$::'
}

_remote_token() {
  if [[ -n "${YOLOIT_REMOTE_TOKEN:-}" ]]; then
    printf "%s" "$YOLOIT_REMOTE_TOKEN"
    return
  fi
  _state_get remoteToken
}

_resolve_base() {
  if [[ -n "$BASE" ]]; then return 0; fi
  local remote
  remote=$(_remote_url)
  if [[ -n "$remote" ]]; then
    BASE="${remote%/}/api"
    return 0
  fi
  if [[ -n "${YOLOIT_CLI_PORT:-}" ]]; then
    BASE="http://127.0.0.1:${YOLOIT_CLI_PORT}/api"
    return 0
  fi
  if [[ ! -f "$PORT_FILE" ]]; then
    return 1
  fi
  local port
  port=$(cat "$PORT_FILE")
  BASE="http://127.0.0.1:${port}/api"
  return 0
}

_resolve_vm_service_ws_uri() {
  # Flutter runs a small `development-service` proxy next to the app. Its
  # command line contains the app VM service URI:
  #   --vm-service-uri=http://127.0.0.1:<port>/<token>=/
  # That endpoint redirects to a DevTools page whose `uri` query parameter is
  # the real WebSocket URI for the running app isolate.
  local http_uri
  http_uri=$(ps aux 2>/dev/null \
    | grep -E 'development-service.*--vm-service-uri=http://127\.0\.0\.1:' \
    | grep -v grep \
    | sed -E 's#.*--vm-service-uri=(http://127\.0\.0\.1:[0-9]+/[^[:space:]]+=/).*#\1#' \
    | head -1)
  if [[ -z "$http_uri" ]]; then
    return 1
  fi
  local ws_uri
  ws_uri=$(curl -Ls -o /dev/null -w '%{url_effective}' "$http_uri" 2>/dev/null \
    | python3 -c '
import sys, urllib.parse
url = sys.stdin.read().strip()
q = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
print(q.get("uri", [""])[0])
' 2>/dev/null)
  if [[ -n "$ws_uri" ]]; then
    printf '%s' "$ws_uri"
    return 0
  fi
  return 1
}

_curl() {
  if ! _resolve_base; then
    echo "{\"ok\":false,\"error\":\"CLI server not reachable — is the YoLoIT app running?\"}"
    return 1
  fi
  local method=$1 path=$2
  shift 2
  local out ec
  local token
  token=$(_remote_token)
  if [[ -n "$token" ]]; then
    out=$(curl -s --max-time 30 -X "$method" "${BASE}${path}" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer ${token}" "$@" 2>/dev/null)
  else
    out=$(curl -s --max-time 30 -X "$method" "${BASE}${path}" \
      -H "Content-Type: application/json" "$@" 2>/dev/null)
  fi
  ec=$?
  if [[ $ec -ne 0 ]] || [[ -z "$out" ]]; then
    echo "{\"ok\":false,\"error\":\"CLI server not reachable — is the YoLoIT app running?\"}"
    return 1
  fi
  echo "$out"
}

_get()    { _curl GET    "$1"; }
_post()   { _curl POST   "$1" -d "${2:-\{\}}"; }
_put()    { _curl PUT    "$1" -d "${2:-\{\}}"; }
_delete() { _curl DELETE "$1"; }

