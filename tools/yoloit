]

def params_inline(c):
    if not c["params"]:
        return "none"
    return ", ".join([f'{p[0]}{"*" if p[2] else ""}' for p in c["params"]])

def param_to_key(name):
    raw = name.strip()
    if raw.startswith("--"):
        raw = raw.split()[0].lstrip("-")
    key = raw.replace("|", "_or_")
    key = re.sub(r"[^a-zA-Z0-9_]+", "_", key)
    key = re.sub(r"_+", "_", key).strip("_").lower()
    return key or "arg"

if fmt == "short":
    print("yoloit help (short)")
    print("Use: yoloit help --format [short|detailed|mermaid|mermaid_short|tools|registry|catalog]")
    print("Board and panel are optional in note/checklist/kanban commands — uses active board/panel.")
    for g in group_order:
        if not by_group[g]:
            continue
        print(f"\n{g}:")
        for c in by_group[g]:
            aliases = c.get("aliases", [])
            alias_str = f'  [aliases: {", ".join(aliases)}]' if aliases else ""
            print(f'  {c["name"]} — {c["description"]}{alias_str}')
            if c["params"]:
                print(f'    params: {params_inline(c)}')
            print(f'    ex: {c["example"]}')
elif fmt == "detailed":
    print("yoloit help (detailed)\n")
    for c in commands:
        aliases = c.get("aliases", [])
        print(f'Command: {c["name"]}')
        if aliases:
            print(f'Aliases: {", ".join(aliases)}')
        print(f'Description: {c["description"]}')
        if c["params"]:
            print("Parameters:")
            for name, desc, req in c["params"]:
                reqs = "required" if req else "optional"
                print(f"  - {name} ({reqs}): {desc}")
        fmt_parts = [c["name"]]
        for name, _, req in c["params"]:
            fmt_parts.append(f'<{name}>' if req else f'[{name}]')
        print(f'CLI command format: yoloit {" ".join(fmt_parts)}')
        print(f'Example: {c["example"]}\n')
elif fmt == "mermaid":
    print("graph TD")
    print("  root[yoloit help]")
    for g in group_order:
        if not by_group[g]:
            continue
        gid = f"g_{g}"
        print(f'  root --> {gid}["{g}"]')
        for i, c in enumerate(by_group[g]):
            cid = f"{gid}_{i}"
            aliases = c.get("aliases", [])
            alias_str = f'<br/>aliases: {", ".join(aliases)}' if aliases else ""
            label = f'{c["name"]}{alias_str}<br/>{c["description"]}'
            if c["params"]:
                label += f'<br/>params: {params_inline(c)}'
            label = label.replace('"', '\\"')
            print(f'  {gid} --> {cid}["{label}"]')
elif fmt == "mermaid_short":
    print("graph LR")
    print("  root[yoloit]")
    for g in group_order:
        if not by_group[g]:
            continue
        gid = f"g_{g}"
        print(f'  root --> {gid}(("{g}"))')
        for i, c in enumerate(by_group[g]):
            cid = f"{gid}_{i}"
            aliases = c.get("aliases", [])
            name_str = c["name"]
            if aliases:
                name_str += f' · {" · ".join(aliases)}'
            name_str = name_str.replace('"', '\\"')
            print(f'  {gid} --> {cid}["{name_str}"]')
elif fmt == "tools":
    tools = []
    for c in commands:
        props = {}
        required = []
        for name, desc, req in c["params"]:
            key = param_to_key(name)
            props[key] = {"type": "string", "description": desc}
            if req:
                required.append(key)
        schema = {
            "type": "object",
            "properties": props,
            "additionalProperties": False,
        }
        if required:
            schema["required"] = required
        tools.append(
            {
                "name": c["name"],
                "aliases": c.get("aliases", []),
                "description": c["description"],
                "inputSchema": schema,
            }
        )
    print(json.dumps({"tools": tools}, ensure_ascii=False, indent=2))
elif fmt == "registry":
    # Machine-readable: all commands + auto-aliases, used by 'validate'
    out = []
    for c in commands:
        out.append({
            "name": c["name"],
            "group": c["group"],
            "aliases": c.get("aliases", []),
        })
    print(json.dumps(out, ensure_ascii=False, indent=2))
elif fmt == "catalog":
    # Fetch catalog from Dart server (includes humanVariants from tool registry)
    import os, urllib.request, urllib.error
    port_file = os.path.expanduser("~/.config/yoloit/cli.port")
    try:
        with open(port_file) as f:
            port = f.read().strip()
        url = f"http://127.0.0.1:{port}/api/catalog"
        req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode())
        print(json.dumps(data, ensure_ascii=False, indent=2))
    except Exception as e:
        print(f"Error: Could not fetch catalog from Dart server: {e}", file=sys.stderr)
        sys.exit(1)
else:
    print(f"Unknown format: {fmt}", file=sys.stderr)
    sys.exit(2)
PYEOF
}

_parse_help_format() {
  local format="short"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format|-f)
        format="${2:-short}"
        shift 2
        ;;
      short|detailed|mermaid|mermaid_short|tools|registry|catalog)
        format="$1"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
  echo "$format"
}

usage() {
  local format="${1:-short}"
  _render_help "$format"
}

# ── Helpers ────────────────────────────────────────────────────────────

_encode() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$1"; }

_auto_panel() {
  local bid=$1 type=$2 title=$3 state=${4:-}
  local body="{\"type\":\"${type}\",\"title\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$title")"
  [[ -n "$state" ]] && body+=",\"state\":${state}"
  body+="}"
  local created pid_result
  created=$(_post "/boards/${bid}/panels" "$body")
  pid_result=$(python3 -c "import json,sys; d=json.loads(sys.stdin.read() or '{}'); print((d.get('panel') or {}).get('id',''))" <<<"$created")
  if [[ -z "$pid_result" ]]; then
    echo "Warning: _auto_panel failed to create panel. API response: $created" >&2
  fi
  echo "$pid_result"
}

# ── Smart board/panel resolution ──────────────────────────────────────

# Returns active board raw name/id: explicit arg → state.json → API active board
_require_board() {
  local explicit="${1:-}"
  if [[ -n "$explicit" ]]; then echo "$explicit"; return; fi
  local from_state
  from_state=$(_board "")
  if [[ -n "$from_state" ]]; then echo "$from_state"; return; fi
  _resolve_base 2>/dev/null || true
  if [[ -n "$BASE" ]]; then
    local name
    name=$(python3 -c "
import json, sys
d = json.loads(sys.stdin.read() or '{}')
b = d.get('board') or {}
print(b.get('name') or b.get('id') or '')
" <<<"$(_get "/active-board" 2>/dev/null)" 2>/dev/null || echo "")
    [[ -n "$name" ]] && { echo "$name"; return; }
  fi
  echo "Error: no board specified and no active board found. Use 'yoloit board:use <name>'." >&2
  exit 1
}

# Find existing panel of given type (optionally matching title hint), or create one.
# Usage: _smart_panel <encoded-bid> <type> [title-hint]
# Returns panel id (raw, not encoded)
_smart_panel() {
  local bid=$1 type=$2 hint="${3:-}"
  local panels_json existing=""
  panels_json=$(_get "/boards/${bid}/panels" 2>/dev/null)
  # Match by title hint first
  if [[ -n "$hint" ]]; then
    existing=$(python3 -c "
import json, sys
d = json.loads(sys.stdin.read() or '{}')
hint = sys.argv[1].lower(); typ = sys.argv[2]
for p in d.get('panels') or []:
    if not p.get('hidden') and (p.get('title','').lower() == hint or p.get('id','').lower() == hint):
        print(p.get('id','')); break
" "$hint" "$type" <<<"$panels_json" 2>/dev/null)
  fi
  # Fallback: first visible panel of matching type
  if [[ -z "$existing" ]]; then
    existing=$(python3 -c "
import json, sys
d = json.loads(sys.stdin.read() or '{}')
typ = sys.argv[1]
for p in d.get('panels') or []:
    if not p.get('hidden') and p.get('type','') == typ:
        print(p.get('id','')); break
" "$type" <<<"$panels_json" 2>/dev/null)
  fi
  if [[ -n "$existing" ]]; then
    echo "$existing"
  else
    # Create a new panel with sensible title
    local display="${hint:-${type##*.}}"
    display=$(python3 -c "import sys; print(sys.argv[1].capitalize())" "$display")
    _auto_panel "$bid" "$type" "$display"
  fi
}

# ── Command dispatch ──────────────────────────────────────────────────

_dispatch() {
local cmd="${1:-help}"
shift || true

case "$cmd" in
  runtime)
    sub="${1:-status}"; shift || true
    runtime_dir="$(_runtime_home)"
    runtime_bin="${runtime_dir}/yoloit_runtime.py"
    runtime_pid="${runtime_dir}/runtime.pid"
    runtime_port="${runtime_dir}/runtime.port"
    source_runtime="${SCRIPT_DIR}/yoloit_runtime.py"
    mkdir -p "$runtime_dir"
    case "$sub" in
      status)
        if [[ -f "$runtime_pid" ]] && kill -0 "$(cat "$runtime_pid")" 2>/dev/null; then
          echo "{\"ok\":true,\"installed\":$(test -x "$runtime_bin" && echo true || echo false),\"running\":true,\"pid\":$(cat "$runtime_pid"),\"port\":$(cat "$runtime_port" 2>/dev/null || echo 0),\"path\":\"$runtime_bin\"}"
        else
          echo "{\"ok\":true,\"installed\":$(test -x "$runtime_bin" && echo true || echo false),\"running\":false,\"path\":\"$runtime_bin\"}"
        fi
        ;;
      install)
        if [[ ! -f "$source_runtime" ]]; then
          echo "{\"ok\":false,\"error\":\"runtime source not found\",\"source\":\"$source_runtime\"}"
          exit 2
        fi
        cp "$source_runtime" "$runtime_bin"
        chmod +x "$runtime_bin"
        echo "{\"ok\":true,\"path\":\"$runtime_bin\"}"
        ;;
      start)
        if [[ -f "$source_runtime" ]] && { [[ ! -x "$runtime_bin" ]] || [[ "$source_runtime" -nt "$runtime_bin" ]]; }; then
          "$0" runtime install >/dev/null
        fi
        if [[ -f "$runtime_pid" ]] && kill -0 "$(cat "$runtime_pid")" 2>/dev/null; then
          "$0" runtime status
          exit 0
        fi
        rm -f "$runtime_port" "$runtime_pid"
        nohup python3 "$runtime_bin" --home "$runtime_dir" >"${runtime_dir}/runtime.log" 2>&1 &
        for _ in {1..50}; do
          if [[ -f "$runtime_port" ]] && [[ -f "$runtime_pid" ]]; then
            "$0" runtime status
            exit 0
          fi
          sleep 0.1
        done
        echo "{\"ok\":false,\"error\":\"runtime did not start\",\"log\":\"${runtime_dir}/runtime.log\"}"
        exit 2
        ;;
      stop)
        if [[ -f "$runtime_pid" ]] && kill -0 "$(cat "$runtime_pid")" 2>/dev/null; then
          kill "$(cat "$runtime_pid")" 2>/dev/null || true
          echo "{\"ok\":true,\"stopped\":true}"
        else
          echo "{\"ok\":true,\"stopped\":false}"
        fi
        ;;
      sessions)
        "$0" runtime start >/dev/null
        curl -s "http://127.0.0.1:$(cat "$runtime_port")/sessions"
        ;;
      create)
        session_id="${1:-runtime_$(date +%s)}"; shift || true
        cwd="$PWD"; command="${SHELL:-/bin/sh}"; cols=120; rows=30
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --cwd) cwd="$2"; shift 2 ;;
            --cmd) command="$2"; shift 2 ;;
            --cols) cols="$2"; shift 2 ;;
            --rows) rows="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        "$0" runtime start >/dev/null
        payload=$(python3 - "$session_id" "$cwd" "$command" "$cols" "$rows" <<'PY'
import json, sys
sid, cwd, cmd, cols, rows = sys.argv[1:6]
print(json.dumps({"id": sid, "cwd": cwd, "command": cmd, "cols": int(cols), "rows": int(rows)}))
PY
)
        curl -s -X POST "http://127.0.0.1:$(cat "$runtime_port")/sessions" -H "Content-Type: application/json" -d "$payload"
        ;;
      input)
        [[ $# -lt 2 ]] && { echo "Usage: yoloit runtime input <session-id> <text>" >&2; exit 1; }
        session_id="$1"; shift
        data="$*"
        "$0" runtime start >/dev/null
        payload=$(python3 - "$data" <<'PY'
import base64, json, sys
print(json.dumps({"data": base64.b64encode(sys.argv[1].encode()).decode()}))
PY
)
        curl -s -X POST "http://127.0.0.1:$(cat "$runtime_port")/sessions/${session_id}/input" -H "Content-Type: application/json" -d "$payload"
        ;;
      resize)
        [[ $# -lt 3 ]] && { echo "Usage: yoloit runtime resize <session-id> <cols> <rows>" >&2; exit 1; }
        session_id="$1"; cols="$2"; rows="$3"
        "$0" runtime start >/dev/null
        curl -s -X POST "http://127.0.0.1:$(cat "$runtime_port")/sessions/${session_id}/resize" -H "Content-Type: application/json" -d "{\"cols\":${cols},\"rows\":${rows}}"
        ;;
      stream)
        [[ $# -lt 1 ]] && { echo "Usage: yoloit runtime stream <session-id>" >&2; exit 1; }
        "$0" runtime start >/dev/null
        curl -s "http://127.0.0.1:$(cat "$runtime_port")/sessions/${1}/stream"
        ;;
      kill)
        [[ $# -lt 1 ]] && { echo "Usage: yoloit runtime kill <session-id>" >&2; exit 1; }
        "$0" runtime start >/dev/null
        curl -s -X POST "http://127.0.0.1:$(cat "$runtime_port")/sessions/${1}/kill" -H "Content-Type: application/json" -d "{}"
        ;;
      *)
        echo "Usage: yoloit runtime <status|install|start|stop|sessions|create|input|resize|stream|kill>" >&2
        exit 1
        ;;
    esac
    ;;

  # ── app control ──
  reload)
    # Hot reload: recompile changed files, preserve app state
    VM_FILE="${HOME}/.config/yoloit/cli.vmservice"
    ws_uri=$(_resolve_vm_service_ws_uri)
    if [[ -z "$ws_uri" ]]; then
      if [[ -f "$VM_FILE" ]]; then
        ws_uri=$(cat "$VM_FILE")
      else
        # Try fetching from server
        _resolve_base
        ws_uri=$(curl -s "${BASE}/vmservice" | python3 -c "import json,sys; print(json.load(sys.stdin).get('vmServiceWsUri',''))" 2>/dev/null)
      fi
    fi
    if [[ -z "$ws_uri" ]]; then
      echo "Error: VM service URI not found. Is the app running in debug mode?" >&2; exit 1
    fi
    echo "Hot reloading via $ws_uri ..."
    python3 - "$ws_uri" <<'PYEOF'
import asyncio, websockets, json, sys

async def reload(uri):
    async with websockets.connect(uri) as ws:
        await ws.send(json.dumps({"jsonrpc":"2.0","id":"1","method":"getVM","params":{}}))
        vm = json.loads(await ws.recv())
        isolate_id = vm["result"]["isolates"][0]["id"]
        await ws.send(json.dumps({"jsonrpc":"2.0","id":"2","method":"reloadSources","params":{"isolateId": isolate_id}}))
        result = json.loads(await ws.recv())
        t = result.get("result",{}).get("type","")
        if t == "ReloadReport":
            print("✅ Hot reload complete")
        else:
            print("⚠️", json.dumps(result))

asyncio.run(reload(sys.argv[1]))
PYEOF
    ;;
  restart)
    # Hot restart: send 'R' to the running flutter run tmux session (triggers
    # full recompile + restart), then fall back to raw VM reloadSources.
    flutter_session=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -i 'flutter_run' | head -1)
    if [[ -n "$flutter_session" ]]; then
      echo "Hot restarting via tmux session: $flutter_session ..."
      tmux send-keys -t "${flutter_session}:0.0" "R" Enter
      sleep 3
      echo "✅ Restart initiated: ReloadReport"
    else
      # Fallback: raw VM service reloadSources (no recompile — use when not running via flutter run)
      VM_FILE="${HOME}/.config/yoloit/cli.vmservice"
      ws_uri=$(_resolve_vm_service_ws_uri)
      if [[ -z "$ws_uri" ]]; then
        if [[ -f "$VM_FILE" ]]; then
          ws_uri=$(cat "$VM_FILE")
        else
          _resolve_base
          ws_uri=$(curl -s "${BASE}/vmservice" | python3 -c "import json,sys; print(json.load(sys.stdin).get('vmServiceWsUri',''))" 2>/dev/null)
        fi
      fi
      if [[ -z "$ws_uri" ]]; then
        echo "Error: VM service URI not found." >&2; exit 1
      fi
      echo "Hot restarting via $ws_uri ..."
      python3 - "$ws_uri" <<'PYEOF'
import asyncio, websockets, json, sys

async def restart(uri):
    async with websockets.connect(uri) as ws:
        await ws.send(json.dumps({"jsonrpc":"2.0","id":"1","method":"getVM","params":{}}))
        vm = json.loads(await ws.recv())
        isolate_id = vm["result"]["isolates"][0]["id"]
        # Full restart: call reloadSources with pause=false and reset=true
        await ws.send(json.dumps({"jsonrpc":"2.0","id":"2","method":"reloadSources",
            "params":{"isolateId": isolate_id, "reset": True}}))
        result = json.loads(await ws.recv())
        print("✅ Restart initiated:", result.get("result",{}).get("type","done"))

asyncio.run(restart(sys.argv[1]))
PYEOF
    fi
    # Wait for new port file to update
    sleep 2
    echo "Port: $(cat ${HOME}/.config/yoloit/cli.port 2>/dev/null)"
    ;;
  remote:connect|rcon)
    [[ $# -lt 1 ]] && { echo "Usage: yoloit remote:connect <url> [token]" >&2; exit 1; }
    remote="${1%/}"
    token="${2:-}"
    _state_set remoteUrl "$remote"
    if [[ -n "$token" ]]; then
      _state_set remoteToken "$token"
    fi
    BASE="${remote}/api"
    health=$(_get "/health" 2>/dev/null || true)
    if printf "%s" "$health" | python3 -m json.tool >/dev/null 2>&1; then
      printf "%s\n" "$health" | python3 -m json.tool
    else
      echo "{\"ok\":true,\"remoteUrl\":\"${remote}\",\"warning\":\"saved but health check did not return JSON\"}"
    fi
    ;;
  remote:disconnect|rdisc)
    _state_del remoteUrl
    _state_del remoteToken
    echo '{"ok":true,"message":"Remote disconnected; using local YoLoIT desktop server"}'
    ;;
  remote:status|rst)
    remote=$(_remote_url)
    token=$(_remote_token)
    if [[ -z "$remote" ]]; then
      echo '{"ok":true,"connected":false,"mode":"local"}'
    else
      python3 -c 'import json,sys; print(json.dumps({"ok": True, "connected": True, "mode": "remote", "url": sys.argv[1], "tokenConfigured": bool(sys.argv[2])}, indent=2))' "$remote" "$token"
    fi
    ;;
  boards)
    _get "/boards" | python3 -m json.tool 2>/dev/null || _get "/boards"
    ;;
  board)
    bid_raw=$(_board "${1:-}")
    [[ -z "$bid_raw" ]] && { echo "Usage: yoloit board [board]" >&2; exit 1; }
    bid=$(_encode "$bid_raw"); _use_board "$bid_raw"
    _get "/boards/${bid}" | python3 -m json.tool 2>/dev/null || _get "/boards/${bid}"
    ;;
  board:create)
    [[ $# -lt 1 ]] && { echo "Usage: yoloit board:create <name>" >&2; exit 1; }
    _post "/boards" "{\"name\":\"$1\"}" | python3 -m json.tool 2>/dev/null
    ;;
  board:rename)
    [[ $# -lt 2 ]] && { echo "Usage: yoloit board:rename <board> <new>" >&2; exit 1; }
    bid=$(_encode "$1"); _use_board "$1"
    _put "/boards/${bid}" "{\"name\":\"$2\"}" | python3 -m json.tool 2>/dev/null
    ;;
  board:folder|bfold)
    [[ $# -lt 2 ]] && { echo "Usage: yoloit board:folder <board> <path|clear>" >&2; exit 1; }
    bid=$(_encode "$1"); _use_board "$1"
    folder="$2"
    if [[ "$folder" == "clear" || "$folder" == "none" || "$folder" == "-" ]]; then
      folder=""
    fi
    payload=$(python3 -c 'import json,sys; print(json.dumps({"defaultFolder": sys.argv[1]}))' "$folder")
    _put "/boards/${bid}" "$payload" | python3 -m json.tool 2>/dev/null
    ;;
  board:delete)
    bid_raw=$(_board "${1:-}")
    [[ -z "$bid_raw" ]] && { echo "Usage: yoloit board:delete [board]" >&2; exit 1; }
    bid=$(_encode "$bid_raw"); _use_board "$bid_raw"
    _delete "/boards/${bid}" | python3 -m json.tool 2>/dev/null
    ;;
  board:focus)
    bid_raw=$(_board "${1:-}")
    [[ -z "$bid_raw" ]] && { echo "Usage: yoloit board:focus [board]" >&2; exit 1; }
    bid=$(_encode "$bid_raw"); _use_board "$bid_raw"
    _put "/boards/${bid}" '{"focus":true}' | python3 -m json.tool 2>/dev/null
    ;;
  board:use)
    [[ $# -lt 1 ]] && { echo "Usage: yoloit board:use <board>" >&2; exit 1; }
    _use_board "$1"
    echo "Current board set to: $1"
    ;;
  board:current)
    local cur
    cur=$(_require_board "")
    if [[ -n "$cur" ]]; then
      echo "$cur"
    else
      echo "No current board found" >&2
      exit 1
    fi
    ;;
  board:apply)
    [[ $# -lt 1 ]] && { echo "Usage: yoloit board:apply <id|name> [file|-]" >&2; exit 1; }
    bid=$(_encode "$1"); _use_board "$1"
    yaml_source="${2:--}"
    if ! _resolve_base; then
      echo '{"ok":false,"error":"CLI server not reachable — is the YoLoIT app running?"}'; exit 1
    fi
    if [[ "$yaml_source" == "-" ]]; then
      curl -s -X POST "${BASE}/boards/${bid}/apply" \
        -H "Content-Type: application/yaml" \
        --data-binary @- | python3 -m json.tool 2>/dev/null
    else
      [[ -f "$yaml_source" ]] || { echo "Error: YAML file not found: $yaml_source" >&2; exit 1; }
      curl -s -X POST "${BASE}/boards/${bid}/apply" \
        -H "Content-Type: application/yaml" \
        --data-binary @"$yaml_source" | python3 -m json.tool 2>/dev/null
    fi
    ;;
  board:snapshot)
    bid_raw=$(_board "")
    if [[ $# -ge 1 && "$1" != -* ]]; then bid_raw="$1"; shift; fi
    [[ -z "$bid_raw" ]] && { echo "Usage: yoloit board:snapshot [board] [--format md|mermaid]" >&2; exit 1; }
    bid=$(_encode "$bid_raw"); _use_board "$bid_raw"
    format="md"
    if [[ "${1:-}" == "--format" ]]; then
      format="${2:-md}"
    elif [[ -n "${1:-}" ]]; then
      format="$1"
    fi
    _get "/boards/${bid}/snapshot?format=${format}"
    ;;
  board:diagram)
    bid_raw=$(_board "")
    if [[ $# -ge 1 && "$1" != -* ]]; then bid_raw="$1"; shift; fi
    [[ -z "$bid_raw" ]] && { echo "Usage: yoloit board:diagram [board] [--format mermaid|md]" >&2; exit 1; }
    bid=$(_encode "$bid_raw"); _use_board "$bid_raw"
    format="mermaid"
    if [[ "${1:-}" == "--format" ]]; then
      format="${2:-mermaid}"
