            return
        if os.path.isdir(full):
            extension = "    " if is_last else "│   "
            walk(full, prefix + extension, depth + 1)

walk(root, "", 1)
print(json.dumps({"ok": True, "path": root, "tree": "\n".join(lines), "entries": entry_count}))
