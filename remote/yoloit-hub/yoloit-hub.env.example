YOLOIT_HUB_PORT=43111
YOLOIT_HUB_ACTOR=server
YOLOIT_HUB_TOKEN=change-me-to-a-long-random-token
YOLOIT_HUB_CORS_ORIGINS=*
# Optional pre-shared static relay device: a Mac connecting with this key
# registers as YOLOIT_HUB_DEVICE_ID without an admin POST /api/devices call.
# Recommended on Cloud Run, where the devices.json store is ephemeral.
#YOLOIT_HUB_DEVICE_KEY=change-me-to-a-long-random-device-key
#YOLOIT_HUB_DEVICE_ID=default
#YOLOIT_HUB_DEVICE_NAME=My Mac
